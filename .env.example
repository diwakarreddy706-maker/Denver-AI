# ==============================================================================
# Denver AI Assistant — Environment Configuration (.env)
# ==============================================================================

# Product Identity
DENVER_ASSISTANT_NAME=Denver
DENVER_PRODUCT_NAME="Denver AI Assistant"
DENVER_SHORT_NAME=Denver

# Environment & Logging
DENVER_ENVIRONMENT=development
DENVER_LOG_LEVEL=INFO
DENVER_LOG_FILE_PATH=logs/denver.log

# Database & Long-Term Memory (Phase 7)
DENVER_DATABASE_PATH=denver_memory.sqlite3
DENVER_PRIVACY_MODE=false
DENVER_MEMORY_ENABLED=true
DENVER_SEMANTIC_MEMORY_ENABLED=true
DENVER_MEMORY_TOP_K=8
DENVER_MEMORY_MAX_RESULTS=20
DENVER_CONTEXT_MAX_TURNS=10
DENVER_CONTEXT_MAX_CHARS=12000
DENVER_MEMORY_DEFAULT_IMPORTANCE=0.5
DENVER_MEMORY_DEFAULT_CONFIDENCE=1.0
DENVER_MEMORY_TTL_HOURS=0.0
DENVER_ALLOW_PRIVATE_CLOUD_CONTEXT=false
DENVER_ALLOW_SENSITIVE_CLOUD_CONTEXT=false
DENVER_EMBEDDING_PROVIDER=lexical
DENVER_EMBEDDING_MODEL=nomic-embed-text

# AI Models & Providers (Phase 2 & 5)
DENVER_AI_MODE=auto
DENVER_AI_ENABLED=true
DENVER_AI_LOCAL_FIRST=true
DENVER_AI_TIMEOUT_SECONDS=10.0
DENVER_PROVIDER_PRIORITY=ollama,lmstudio,groq,gemini
DENVER_CLOUD_FALLBACK_ENABLED=false

# Local AI Providers
DENVER_OLLAMA_ENABLED=true
DENVER_OLLAMA_BASE_URL=http://localhost:11434
DENVER_OLLAMA_MODEL=llama3.2

DENVER_LMSTUDIO_ENABLED=true
DENVER_LMSTUDIO_BASE_URL=http://localhost:1234/v1
DENVER_LMSTUDIO_MODEL=local-model

# Cloud Fallback Providers
DENVER_GROQ_ENABLED=true
DENVER_GROQ_BASE_URL=https://api.groq.com/openai/v1
DENVER_GROQ_API_KEY=
DENVER_GROQ_MODEL=llama-3.1-8b-instant

DENVER_GEMINI_ENABLED=true
DENVER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DENVER_GEMINI_API_KEY=
DENVER_GEMINI_MODEL=gemini-1.5-flash

# Voice & Audio Pipeline (Phase 3 & 4)
DENVER_VOICE_ENABLED=true
DENVER_AUDIO_ENABLED=true
DENVER_AUDIO_INPUT_DEVICE=
DENVER_AUDIO_OUTPUT_DEVICE=
DENVER_VAD_ENABLED=true
DENVER_VAD_THRESHOLD=0.5
DENVER_VAD_MIN_SPEECH_MS=250
DENVER_VAD_MIN_SILENCE_MS=500
DENVER_VAD_MAX_UTTERANCE_SECONDS=15.0
DENVER_WAKE_WORD=Denver
DENVER_WAKE_WORD_ENABLED=true
DENVER_WAKE_WORD_COOLDOWN_SECONDS=1.0
DENVER_WAKE_WORD_THRESHOLD=0.5
DENVER_STT_ENABLED=true
DENVER_STT_PROVIDER=whisper
DENVER_STT_MODEL=base
DENVER_STT_LANGUAGE=en
DENVER_TTS_ENABLED=true
DENVER_TTS_PROVIDER=edge
DENVER_TTS_VOICE=en-GB-RyanNeural
DENVER_TTS_RATE=+0%
DENVER_TTS_VOLUME=+0%
DENVER_TTS_PITCH=+0Hz
DENVER_LANGUAGE=en-US

# Automation & Safety Constraints (Phase 1)
DENVER_UI_ENABLED=true
DENVER_AUTOMATION_ENABLED=true
DENVER_AUTOMATION_CONFIRMATION_TIMEOUT=30.0
DENVER_ALLOW_HIGH_RISK_ACTIONS=false
DENVER_ALLOW_DESTRUCTIVE_ACTIONS=false
DENVER_DEFAULT_BROWSER=default
DENVER_SCREENSHOT_DIRECTORY=data/screenshots
DENVER_ACTION_SEQUENCE_DELAY=0.1
DENVER_APP_LAUNCH_DELAY=0.2

# Proactive Intelligence & Scheduled Routines (Phase 8)
DENVER_SCHEDULER_ENABLED=true
DENVER_SCHEDULER_MAX_CONCURRENCY=2
DENVER_SCHEDULER_DEFAULT_TIMEOUT_SECONDS=60.0
DENVER_SCHEDULER_MIN_INTERVAL_SECONDS=300.0
DENVER_SCHEDULER_GLOBAL_PAUSE=false
DENVER_SCHEDULER_NOTIFICATION_RATE_LIMIT_SECONDS=10.0

# Intelligent Task & Workflow Orchestration (Phase 9)
DENVER_TASKS_ENABLED=true
DENVER_TASK_MAX_CONCURRENCY=2
DENVER_TASK_DEFAULT_TIMEOUT_SECONDS=600.0
DENVER_TASK_STEP_TIMEOUT_SECONDS=60.0
DENVER_TASK_MAX_STEPS=20
DENVER_TASK_MAX_DEPTH=10
DENVER_TASK_MAX_RETRIES=1
DENVER_TASK_GLOBAL_PAUSE=false

# Live Weather (Phase 10 - Open-Meteo & Web Fallback)
DENVER_WEATHER_PROVIDER=open-meteo
DENVER_WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
DENVER_WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
DENVER_WEATHER_TIMEOUT_SECONDS=8.0
DENVER_WEATHER_FALLBACK_TO_WEB_AGENT=true

# Fastest-Route Navigation (Phase 10 - OSRM, Google Maps, Browser)
DENVER_ROUTING_PROVIDER=osrm
DENVER_OSRM_BASE_URL=
DENVER_OSRM_TIMEOUT_SECONDS=8.0
DENVER_GOOGLE_MAPS_ENABLED=false
DENVER_GOOGLE_MAPS_API_KEY=
DENVER_ROUTE_OPEN_IN_BROWSER=true

# Live Current Location (Phase 11 - Geolocation & Fast Cache)
DENVER_LOCATION_PROVIDER_PRIMARY=ipapi.co
DENVER_LOCATION_PROVIDER_FALLBACK=ip-api.com
DENVER_LOCATION_CACHE_TTL_SECONDS=600
DENVER_LOCATION_TIMEOUT_SECONDS=5.0

